# Copiar a .env (nunca commitear valores reales)
NODE_ENV=development
PORT=3002
# Conexion con pooling para runtime (Neon pooled + ?pgbouncer=true)
DATABASE_URL=postgresql://usuario:password@host:5432/rate_availability_db?sslmode=require
# Conexion directa SIN pooling, solo para `prisma migrate deploy`
DIRECT_URL=postgresql://usuario:password@host:5432/rate_availability_db?sslmode=require
# Redis para cache-aside (Render Key Value). Vacio = cache deshabilitada, opera igual.
REDIS_URL=
# TTLs de cache en segundos
RATE_CACHE_AVAIL_TTL=60
RATE_CACHE_RATES_TTL=300

# HS256 compartido con user-service (min 32 chars)
AUTH_JWT_SECRET=

# Clave interna Booking -> R&A (header x-service-key)
SERVICE_API_KEY=

# --- Gateway: verificación de x-gateway-secret (ver ROLLOUT-GATEWAY.md) ---
# Secreto compartido entre gateway/BFF y los 11 servicios. Vacío = verificación apagada.
GATEWAY_SECRET=
# Solo durante una rotación: el secreto anterior que aún se acepta.
GATEWAY_SECRET_PREVIOUS=
# warn (por defecto): solo registra; enforce: responde 401 si falta el secreto.
GATEWAY_MODE=warn
