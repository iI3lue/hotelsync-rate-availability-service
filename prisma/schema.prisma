generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Inventory {
  inventory_id    String   @id @default(uuid()) @db.Uuid
  room_type_id    String   @db.Uuid
  date            DateTime @db.Date
  available_count Int
  blocked_count   Int

  @@unique([room_type_id, date])
  @@index([room_type_id, date])
  @@map("inventory")
}

model Rate {
  rate_id      String   @id @default(uuid()) @db.Uuid
  room_type_id String   @db.Uuid
  report_date  DateTime @db.Date
  price        Decimal  @db.Decimal(10, 2)

  @@map("rates")
}

model RateRule {
  rule_id      String   @id @default(uuid()) @db.Uuid
  room_type_id String   @db.Uuid
  start_date   DateTime @db.Date
  end_date     DateTime @db.Date
  multiplier   Decimal  @db.Decimal(5, 2)
  min_stay     Int

  @@map("rate_rules")
}

model ProcessedEvent {
  event_id     String   @id @db.Uuid
  event_type   String   @db.VarChar(50)
  processed_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("processed_events")
}

/**
 * Claves de idempotencia para reserve/release. Un reintento de Booking
 * con la misma clave no descuenta ni libera inventario dos veces.
 */
model AppliedKey {
  key        String   @id @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("applied_keys")
}

model EventOutbox {
  event_id   String    @id @default(uuid()) @db.Uuid
  event_type String    @db.VarChar(50)
  payload    Json      @db.Json
  status     String    @default("pending") @db.VarChar(20)
  attempts   Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  sent_at    DateTime? @db.Timestamptz(6)

  @@index([status, created_at])
  @@map("event_outbox")
}
